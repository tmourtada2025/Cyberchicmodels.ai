{
  "framework": "vite",
  "buildCommand": "cd Cyberchicmodels.ai-main && npm install && npm run build",
  "outputDirectory": "Cyberchicmodels.ai-main/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}